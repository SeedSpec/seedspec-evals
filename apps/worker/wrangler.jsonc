{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seedspec-eval-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "SeedSpecEvalAgent", "class_name": "SeedSpecEvalAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SeedSpecEvalAgent"] }
  ],
  "workflows": [
    { "binding": "EVAL_MATRIX", "name": "seedspec-eval-matrix", "class_name": "SeedSpecEvalMatrixWorkflow" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
