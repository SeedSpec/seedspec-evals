{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/releases/0.3.0/schemas/context-preparation-receipt.schema.json",
  "title": "SeedSpec Context Preparation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "receipt_id", "subject", "producer"],
  "properties": {
    "receipt_version": { "const": "1" },
    "receipt_id": { "$ref": "#/$defs/digest" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "protocol_release", "resolution_receipt", "context_index_digest", "request_digest", "modules", "result"],
      "properties": {
        "operation": { "const": "prepare-context" },
        "protocol_release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "digest"],
          "properties": {
            "id": { "$ref": "#/$defs/semver" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "resolution_receipt": { "$ref": "#/$defs/digest" },
        "context_index_digest": { "$ref": "#/$defs/digest" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "source_digest", "mechanism"],
            "properties": {
              "module": { "$ref": "#/$defs/qualifiedModuleId" },
              "source_digest": { "$ref": "#/$defs/digest" },
              "mechanism": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["native-adapter", "bridge-skills", "plain-markdown"] },
                  "id": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "version": { "$ref": "#/$defs/semver" },
                  "digest": { "$ref": "#/$defs/digest" },
                  "skills": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "digest"],
                      "properties": {
                        "id": { "$ref": "#/$defs/qualifiedModuleId" },
                        "digest": { "$ref": "#/$defs/digest" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundle_id", "bundle_digest"],
          "properties": {
            "bundle_id": { "$ref": "#/$defs/digest" },
            "bundle_digest": { "$ref": "#/$defs/digest" }
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "qualifiedModuleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9][a-z0-9-]*){2,}/[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
