{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/releases/0.3.0/schemas/context-use-receipt.schema.json",
  "title": "SeedSpec Reported Context Use Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "receipt_id", "subject", "consumer", "producer", "observed_at"],
  "properties": {
    "receipt_version": { "const": "1" },
    "receipt_id": { "$ref": "#/$defs/digest" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "preparation_receipt", "bundle_id", "modules"],
      "properties": {
        "operation": { "const": "record-context-use" },
        "preparation_receipt": { "$ref": "#/$defs/digest" },
        "bundle_id": { "$ref": "#/$defs/digest" },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "status"],
            "properties": {
              "module": { "$ref": "#/$defs/qualifiedModuleId" },
              "status": { "enum": ["consulted", "partially-consulted", "skipped"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "evidence": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 500 }
              }
            }
          }
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "qualifiedModuleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9][a-z0-9-]*){2,}/[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
