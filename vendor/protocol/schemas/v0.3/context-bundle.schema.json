{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/releases/0.3.0/schemas/context-bundle.schema.json",
  "title": "Prepared SeedSpec Context Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "protocol_version", "bundle_id", "request", "source", "modules", "excluded_modules"],
  "properties": {
    "bundle_version": { "const": "1" },
    "protocol_version": { "const": "0.3" },
    "bundle_id": { "$ref": "#/$defs/digest" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "summary", "purpose", "audiences"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "purpose": { "$ref": "#/$defs/contextPurpose" },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contextAudience" }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_index_digest", "resolution_receipt"],
      "properties": {
        "context_index_digest": { "$ref": "#/$defs/digest" },
        "resolution_receipt": { "$ref": "#/$defs/digest" }
      }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/preparedModule" }
    },
    "excluded_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "reason"],
        "properties": {
          "module": { "$ref": "#/$defs/qualifiedModuleId" },
          "reason": { "enum": ["not-applicable", "explicitly-excluded", "unavailable", "bridge-unavailable"] }
        }
      }
    }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9][a-z0-9-]*){2,}$"
    },
    "qualifiedModuleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9][a-z0-9-]*){2,}/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*/?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contextPurpose": {
      "oneOf": [
        { "enum": ["author", "implement", "review", "evaluate", "verify", "operate"] },
        { "$ref": "#/$defs/namespacedId" }
      ]
    },
    "contextAudience": {
      "oneOf": [
        { "enum": ["authoring-agent", "implementing-agent", "target-agent", "reviewer", "evaluator", "operator", "end-user"] },
        { "$ref": "#/$defs/namespacedId" }
      ]
    },
    "includedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": { "enum": ["valid", "invalid", "not-run"] },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "code", "message"],
            "properties": {
              "severity": { "enum": ["error", "warning"] },
              "code": { "type": "string", "minLength": 1, "maxLength": 160 },
              "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "path": { "$ref": "#/$defs/relativePath" }
            }
          }
        }
      }
    },
    "mechanism": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "adapter", "version"],
          "properties": {
            "kind": { "const": "native-adapter" },
            "adapter": { "$ref": "#/$defs/namespacedId" },
            "version": { "$ref": "#/$defs/semver" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "skills"],
          "properties": {
            "kind": { "const": "bridge-skills" },
            "skills": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["skill", "digest", "path"],
                "properties": {
                  "skill": { "$ref": "#/$defs/qualifiedModuleId" },
                  "digest": { "$ref": "#/$defs/digest" },
                  "path": { "$ref": "#/$defs/relativePath" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "plain-markdown" }
          }
        }
      ]
    },
    "preparedModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "role", "format", "source_digest", "mechanism", "included_files", "output", "validation"],
      "properties": {
        "module": { "$ref": "#/$defs/qualifiedModuleId" },
        "role": { "enum": ["primary-intent", "supporting"] },
        "format": { "$ref": "#/$defs/namespacedId" },
        "format_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "source_digest": { "$ref": "#/$defs/digest" },
        "mechanism": { "$ref": "#/$defs/mechanism" },
        "included_files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/includedFile" }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "validation": { "$ref": "#/$defs/validation" }
      }
    }
  }
}
