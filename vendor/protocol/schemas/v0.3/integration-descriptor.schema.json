{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedspec.dev/releases/0.3.0/schemas/integration-descriptor.schema.json",
  "title": "SeedSpec Format Integration Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["integration_descriptor_version", "id", "version", "formats"],
  "properties": {
    "integration_descriptor_version": { "const": "1" },
    "id": { "$ref": "#/$defs/namespacedId" },
    "version": { "$ref": "#/$defs/semver" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "documentation": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1, "maxLength": 100 },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/namespacedId" },
          "versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "unversioned": { "type": "boolean" },
          "entrypoints": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relativePath" }
          }
        },
        "anyOf": [
          { "required": ["versions"] },
          { "properties": { "unversioned": { "const": true } }, "required": ["unversioned"] }
        ]
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "adapter_api_version", "entrypoint", "digest", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/namespacedId" },
        "version": { "$ref": "#/$defs/semver" },
        "adapter_api_version": { "const": "1" },
        "entrypoint": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "pattern": "\\.mjs$" }
          ]
        },
        "digest": { "$ref": "#/$defs/digest" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["inspect", "validate", "prepare"] }
        }
      }
    },
    "bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "path", "entrypoint", "digest", "formats"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "path": { "$ref": "#/$defs/relativePath" },
          "entrypoint": { "const": "SKILL.md" },
          "digest": { "$ref": "#/$defs/digest" },
          "formats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/namespacedId" }
          },
          "default": { "type": "boolean" },
          "applies_to": { "$ref": "#/$defs/applicability" }
        }
      }
    }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9][a-z0-9-]*){2,}$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*/?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contextPurpose": {
      "oneOf": [
        { "enum": ["author", "implement", "review", "evaluate", "verify", "operate"] },
        { "$ref": "#/$defs/namespacedId" }
      ]
    },
    "contextAudience": {
      "oneOf": [
        { "enum": ["authoring-agent", "implementing-agent", "target-agent", "reviewer", "evaluator", "operator", "end-user"] },
        { "$ref": "#/$defs/namespacedId" }
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contextPurpose" }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contextAudience" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        }
      },
      "minProperties": 1
    }
  }
}
